{
  "name": "@backoffice/api",
  "version": "0.14.0",
  "private": true,
  "description": "Fastify API: the only code that talks to Postgres; sign-in, staff routes and the jobs' entrypoints",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:db": "vitest --run --config vitest.db.config.ts",
    "test:coverage": "vitest --run --coverage",
    "docker:build": "docker buildx build ${DOCKER_PLATFORM:+--platform=$DOCKER_PLATFORM} -t \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}pauseai-es/backoffice-api:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\" -f Dockerfile ../..",
    "docker:push": "docker push \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}pauseai-es/backoffice-api:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\""
  },
  "dependencies": {
    "@backoffice/db": "workspace:*",
    "@backoffice/domain": "workspace:*",
    "@backoffice/i18n": "workspace:*",
    "@backoffice/observability": "workspace:*",
    "@better-auth/passkey": "1.7.12",
    "@sentry/node": "11.9.0",
    "better-auth": "1.7.12",
    "csv-parse": "7.0.3",
    "fastify": "5.12.7",
    "kysely": "0.29.7",
    "nodemailer": "10.2.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sentry/core": "11.9.0",
    "@slango.configs/lint-staged": "2.0.11",
    "@slango.configs/oxlint": "0.1.16",
    "@slango.configs/typescript": "3.0.1",
    "@slango.configs/vitest": "2.1.5",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
