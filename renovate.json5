{
  // slango's shared preset for an application: one weekly window early on Monday, every non-major update in one PR,
  // a 3-day supply-chain delay (keep in sync with minimumReleaseAge in pnpm-workspace.yaml), @slango/* as soon as it's
  // released. Only this repository's own rules go here.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>danilupion/slango//renovate/app.json5'],
}
