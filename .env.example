# Copy to .env for local development. dbmate reads DATABASE_URL from .env.
# These are the local, non-secret defaults from compose.yaml (Postgres on port 5434, ADR-0001).
DATABASE_URL=postgres://pauseai_backoffice_owner:dev-only-owner@localhost:5434/pauseai_backoffice?sslmode=disable
TEST_DATABASE_URL=postgres://pauseai_backoffice_owner:dev-only-owner@localhost:5434/pauseai_backoffice_test?sslmode=disable
TEST_SUPERUSER_DATABASE_URL=postgres://postgres:postgres@localhost:5434/pauseai_backoffice_test?sslmode=disable
# Better Auth's own role (ADR-0002), for the API's database tests.
TEST_AUTH_DATABASE_URL=postgres://pauseai_backoffice_auth:dev-only-auth@localhost:5434/pauseai_backoffice_test?sslmode=disable
# The role signed-in requests run as (withActor), for the API's database tests.
TEST_APP_DATABASE_URL=postgres://pauseai_backoffice_app:dev-only-app@localhost:5434/pauseai_backoffice_test?sslmode=disable
# The Airtable sync's role (ADR-0005), for the API's database tests.
TEST_INGEST_DATABASE_URL=postgres://pauseai_backoffice_ingest:dev-only-ingest@localhost:5434/pauseai_backoffice_test?sslmode=disable
# The census form's role (ADR-0002 §7), for the API's database tests.
TEST_PUBLIC_DATABASE_URL=postgres://pauseai_backoffice_public:dev-only-public@localhost:5434/pauseai_backoffice_test?sslmode=disable
# Sign-in runs as Better Auth's role, and signed-in requests as the app role (ADR-0002); the end-to-end tests need
# both. Running the API by hand with sign-in also needs STAFF_ORIGIN, BETTER_AUTH_SECRET and PRODUCT_NAME.
AUTH_DATABASE_URL=postgres://pauseai_backoffice_auth:dev-only-auth@localhost:5434/pauseai_backoffice?sslmode=disable
APP_DATABASE_URL=postgres://pauseai_backoffice_app:dev-only-app@localhost:5434/pauseai_backoffice?sslmode=disable

# scripts/watch-release.sh: the addresses that must answer 200 once a release is out, space-separated.
# WATCH_URLS="https://backoffice.example.org/healthz"
