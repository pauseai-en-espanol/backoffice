{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build:watch": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "build:check": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["lint", "test", "build:check"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:db": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_SUPERUSER_DATABASE_URL",
        "TEST_AUTH_DATABASE_URL",
        "TEST_APP_DATABASE_URL",
        "TEST_INGEST_DATABASE_URL",
        "TEST_PUBLIC_DATABASE_URL"
      ]
    },
    "@backoffice/api#test:db": {
      "dependsOn": ["^build", "@backoffice/db#test:db"],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_SUPERUSER_DATABASE_URL",
        "TEST_AUTH_DATABASE_URL",
        "TEST_APP_DATABASE_URL",
        "TEST_INGEST_DATABASE_URL",
        "TEST_PUBLIC_DATABASE_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build",
        "@backoffice/web#build",
        "@backoffice/api#build",
        "@backoffice/forms#build"
      ],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "PLAYWRIGHT_*",
        "DATABASE_URL",
        "AUTH_DATABASE_URL",
        "APP_DATABASE_URL",
        "PUBLIC_DATABASE_URL"
      ]
    },
    "docker:build": {
      "cache": false
    },
    "docker:push": {
      "dependsOn": ["docker:build"],
      "cache": false
    }
  },
  "globalPassThroughEnv": ["DOCKER_REGISTRY", "DOCKER_PLATFORM", "DOCKER_TAG_SUFFIX"]
}
