# The deploy scripts' settings for one cluster (scripts/lib/deploy-settings.sh). Copy this file to
# <path-to-gitops>/backoffice-deploy.env, in the private gitops repository, and put the real values there: every value
# here is fictional, and the real ones never go in this public repository. None is a secret. Paths are relative to the
# gitops checkout's root. One KEY=value per line, taken literally (no quoting needed, a `$` stays a `$`).

# The backoffice's resources directory: its SealedSecrets go in <APP_DIR>/secrets.
APP_DIR=clusters/example/resources/apps/pauseai-es-backoffice
# The backoffice's values file for the cluster, which the scripts' closing hints name (optional).
VALUES_FILE=clusters/example/values/apps/pauseai-es-backoffice.yaml
# The shared Postgres instance's resources directory and namespace, where the roles' passwords are sealed for its
# provisioning hook.
PG_DIR=clusters/example/resources/data/postgres
PG_NAMESPACE=example-postgres
# The backoffice's namespace (optional: pauseai-es-backoffice by default).
NAMESPACE=pauseai-es-backoffice
# kubeseal's arguments: the cluster's kubectl context and the Sealed Secrets controller (or `--cert <file>` for a dry
# run against a throwaway certificate).
KUBESEAL_ARGS=--context example --controller-namespace example-sealing --controller-name example-sealing
# The registry the cluster pulls the images from, its pull-only robot, and an image the robot must be able to pull
# (optional: pauseai-es/backoffice-migrations by default).
HARBOR_URL=https://registry.example.org
HARBOR_ROBOT=robot$example-pull
HARBOR_REPOSITORY=pauseai-es/backoffice-migrations
# Postgres as the pods reach it, host:port.
DB_HOST=postgres.example.test:5432
# GlitchTip as the pods reach it: the DSNs pasted from its UI are rewritten to this host.
GLITCHTIP_HOST=errors.example.test
# The mail server's submission as the pods reach it, its port (optional: 465, SMTPS), and the name on its certificate.
SMTP_HOST=mail.example.test
SMTP_PORT=465
TLS_SERVERNAME=mail.example.org
